rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper validation primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Platform navigation tabs and subpages
    match /platform_tabs/{tabId} {
      allow read: if isValidId(tabId);
      allow write: if isValidId(tabId);
    }

    // Academic guides for physical education
    match /academic_guides/{guideId} {
      allow read: if isValidId(guideId);
      allow write: if isValidId(guideId);
    }

    // Student evidence and homework submissions
    match /ef_group_submissions/{submissionId} {
      allow read: if isValidId(submissionId);
      allow create: if isValidId(submissionId);
      allow update: if isValidId(submissionId);
      allow delete: if isValidId(submissionId);
    }

    // Portfolio applications and code demos
    match /portfolio_applications/{appId} {
      allow read: if isValidId(appId);
      allow write: if isValidId(appId);
    }

    // Store items and services
    match /store_inventory_and_services/{itemId} {
      allow read: if isValidId(itemId);
      allow write: if isValidId(itemId);
    }
  }
}
